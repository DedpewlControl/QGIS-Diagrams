       <rule key="{5b313071-b2ca-4fc5-87fc-b03efd868734}" description="Adjacent_UpperOnly" filter="name IN ('NOR2', 'NOR4', 'BOT6', 'BOT7', 'PADH1', 'PADH2', 'RUD1', 'RUD5', 'TAU3', 'SIG6', 'EBBU EHS')">
        <settings calloutType="simple">
         <text-style textOrientation="horizontal" blendMode="0" multilineHeight="0.69999999999999996" tabStopDistance="350" fontUnderline="0" forcedItalic="0" fontSize="9" fontSizeUnit="Point" namedStyle="Regular" textOpacity="1" tabStopDistanceUnit="Point" multilineHeightUnit="Percentage" previewBkgrdColor="255,255,255,255,rgb:1,1,1,1" tabStopDistanceMapUnitScale="3x:0,0,0,0,0,0" isExpression="1" fontWeight="50" fontLetterSpacing="0" legendString="Aa" allowHtml="1" fontItalic="0" fontWordSpacing="0" fieldName="'&lt;p>___&lt;p>&lt;b>' ||&#xd;&#xa;regexp_replace(name, '(TMA).*', '\\1')&#xd;&#xa;|| '&lt;/b>&amp;nbsp;' ||&#xd;&#xa;CASE&#xd;&#xa;WHEN level_upper &lt; 10 THEN '00' || level_upper&#xd;&#xa;WHEN level_upper &lt; 100 THEN '0' || level_upper&#xd;&#xa;ELSE level_upper&#xd;&#xa;END&#xd;&#xa;" fontSizeMapUnitScale="3x:0,0,0,0,0,0" stretchFactor="100" textColor="151,153,155,255,rgb:0.59215686274509804,0.59999999999999998,0.60784313725490191,1" forcedBold="0" fontStrikeout="0" fontFamily="Droid Sans Mono" fontKerning="1" useSubstitutions="1" capitalization="0">
          <families/>
